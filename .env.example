# 邀请码（多个用逗号分隔）
INVITE_CODES=letmein,radio2026

# JWT 密钥
SECRET_KEY=change-me-to-a-random-string

# 网易云 cookie（登录后从浏览器复制；用于 VIP 解析）
# 注意：cookie 中的双引号要保留，等号也要保留
NETEASE_COOKIE=

# 海外 VPS 部署时必填：伪装成大陆 IP，否则 cookie 会被风控降级
# 默认 116.25.146.177（社区常用），失效时换一个国内电信公网 IP 即可
NETEASE_REAL_IP=116.25.146.177

# 兜底歌单 ID（网易云歌单 URL 末尾的数字）。队列空了从这里随机抽
FALLBACK_PLAYLIST_ID=

# 前端暴露端口（本地开发 8080；线上未备案推荐 8443）
HTTP_PORT=8080
